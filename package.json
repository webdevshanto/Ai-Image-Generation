{
  "name": "ai-image-generation-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/server.js",
    "format": "prettier --write 'src/**/*.ts' 'prisma/**/*.ts' package.json tsconfig.json eslint.config.mjs prisma.config.ts pnpm-workspace.yaml",
    "format:check": "prettier --check 'src/**/*.ts' 'prisma/**/*.ts' package.json tsconfig.json eslint.config.mjs prisma.config.ts pnpm-workspace.yaml",
    "lint": "eslint .",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@prisma/adapter-neon": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.2",
    "bullmq": "^6.3.16",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "disposable-email-domains": "^1.0.62",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.2",
    "rate-limit-redis": "^6.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/disposable-email-domains": "^1.0.6",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
