{
  "info": {
    "name": "AI Image API",
    "description": "Local health checks and authentication requests. Signup and login need the migrated Neon database.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string",
      "description": "Local backend URL. Change this if the server uses another host or port."
    }
  ],
  "item": [
    {
      "name": "Health",
      "description": "Basic server and dependency checks.",
      "item": [
        {
          "name": "Root",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/",
            "description": "Returns a plain-text message."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Root responds with 200', () => pm.response.to.have.status(200));",
                  "pm.test('Root is plain text', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('text/plain'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Lightweight liveness endpoint; does not require Neon or Redis."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Health responds with 200', () => pm.response.to.have.status(200));",
                  "pm.test('Health response is JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
                  "pm.test('Health reports live', () => pm.expect(pm.response.json().data.status).to.eql('live'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Readiness",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health/ready",
            "description": "Returns 200 when Neon and Redis are available, or 503 when one is unavailable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Readiness reports a known dependency state', () => pm.expect([200, 503]).to.include(pm.response.code));",
                  "pm.test('Readiness response is JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "description": "Run in order: Create account, Verify email, Sign in, Current user. Create account emails an OTP; Verify email creates the account after validation.",
      "item": [
        {
          "name": "Create account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Postman\",\n  \"lastName\": \"Test\",\n  \"email\": \"your-email@gmail.com\",\n  \"password\": \"Postman-Test-Password-123!\",\n  \"confirmPassword\": \"Postman-Test-Password-123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/auth/register",
            "description": "Replace your-email@gmail.com with an inbox you can access. Only Gmail/Googlemail, Outlook/Hotmail/Live/MSN, and listed Yahoo domains are accepted; known disposable domains are blocked. Signup OTP requests are rate-limited."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Signup stores pending details and sends verification OTP', () => pm.response.to.have.status(202));",
                  "pm.test('Signup requires email verification', () => pm.expect(pm.response.json().data.emailVerificationRequired).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify email",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"your-email@gmail.com\",\n  \"otp\": \"123456\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/auth/verify-email",
            "description": "Paste the 6-digit code sent after Create account. A valid code verifies the email and creates the account."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Email verification creates the account', () => pm.response.to.have.status(201));",
                  "pm.test('Created account is verified and has no password hash', () => { const body = pm.response.json(); pm.expect(body.data.user.emailVerified).to.eql(true); pm.expect(body.data.user).not.to.have.property('passwordHash'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Sign in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"your-email@gmail.com\",\n  \"password\": \"Postman-Test-Password-123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/auth/login",
            "description": "Run after Verify email creates the account. Postman stores the 15-minute access cookie and 30-day refresh cookie automatically."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeds', () => pm.response.to.have.status(200));",
                  "pm.test('Login returns a verified user', () => pm.expect(pm.response.json().data.user.emailVerified).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/me",
            "description": "Run after Sign in. Postman sends the stored access-token cookie automatically."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Current user is authenticated', () => pm.response.to.have.status(200));",
                  "pm.test('Current user has an allowed provider address', () => pm.expect(pm.response.json().data.user.email).to.match(/@(gmail|googlemail|outlook|hotmail|live|msn|yahoo|ymail|rocketmail)\\./i));",
                  "pm.test('Current user exposes verification state', () => pm.expect(pm.response.json().data.user.emailVerified).to.be.a('boolean'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh session",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/refresh",
            "description": "Uses the HttpOnly refresh cookie and rotates both cookies. Run this when the 15-minute access token expires; do not send the refresh token in the body."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Session refresh succeeds', () => pm.response.to.have.status(200));",
                  "pm.test('Refreshed session returns a verified user', () => pm.expect(pm.response.json().data.user.emailVerified).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Sign out",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/logout",
            "description": "Revokes this refresh-token session and clears both auth cookies."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Sign out succeeds', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Account settings",
      "description": "Run after Sign in. Profile/password/delete need the login cookie; reset codes come by email or from the development terminal.",
      "item": [
        {
          "name": "Forgot password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"your-email@gmail.com\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/auth/password/forgot"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Reset request accepted', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reset password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"otp\": \"123456\",\n  \"password\": \"Postman-New-Password-123!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/auth/password/reset",
            "description": "Paste the 6-digit one-time reset code from the email or development terminal into otp before running. It expires in 30 minutes. The new password must be at least 8 characters and include uppercase, lowercase, number, and symbol."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Password reset succeeds', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Change password",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"Postman-Test-Password-123!\",\n  \"newPassword\": \"Postman-New-Password-123!\",\n  \"confirmPassword\": \"Postman-New-Password-123!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/auth/password",
            "description": "Requires a signed-in user. newPassword and confirmPassword must match; the new password must be at least 8 characters and include uppercase, lowercase, number, and symbol. Changing the password revokes refresh sessions and clears this browser's auth cookies."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Password change succeeds', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update profile",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Updated\",\n  \"lastName\": \"Postman User\",\n  \"email\": \"your-new-email@gmail.com\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/auth/me",
            "description": "Requires a signed-in user. Use an unused Gmail, Outlook, or Yahoo address; known disposable domains are blocked and email changes are rate-limited. emailVerified stays false until the new address is verified."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Profile update succeeds', () => pm.response.to.have.status(200));",
                  "pm.test('Changed email is unverified until confirmed', () => pm.expect(pm.response.json().data.user.emailVerified).to.eql(false));"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify changed email",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"your-new-email@gmail.com\",\n  \"otp\": \"123456\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/auth/verify-email",
            "description": "Run after Update profile. Paste the 6-digit code sent to the new email address."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Changed email verification succeeds', () => pm.response.to.have.status(200));",
                  "pm.test('Changed email is verified', () => pm.expect(pm.response.json().data.emailVerified).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete account (destructive)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"Postman-Test-Password-123!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/auth/me",
            "description": "Permanently deletes the signed-in account and its related records. Update the password in the body to the account's current password before running."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Account deletion succeeds', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
