{
  "info": {
    "name": "AI Image Generation API",
    "description": "Local API checks and authentication flow. Valid signup/login requests require a configured Neon database and applied Prisma migration. Postman stores and resends the HttpOnly auth cookie automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "testEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "testPassword",
      "value": "Postman-Test-Password-123!",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Root plain-text status",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/",
            "description": "Returns a plain-text message."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Root responds with 200', () => pm.response.to.have.status(200));",
                  "pm.test('Root is plain text', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('text/plain'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Health JSON",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Lightweight liveness endpoint; does not require Neon or Redis."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Health responds with 200', () => pm.response.to.have.status(200));",
                  "pm.test('Health response is JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
                  "pm.test('Health reports live', () => pm.expect(pm.response.json().data.status).to.eql('live'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Readiness JSON",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health/ready",
            "description": "Returns 200 when Neon and Redis are available, or 503 when one is unavailable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Readiness reports a known dependency state', () => pm.expect([200, 503]).to.include(pm.response.code));",
                  "pm.test('Readiness response is JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register validation error (no database required)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"not-an-email\",\n  \"password\": \"short\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/auth/register",
            "description": "Expected: 400 JSON validation error. This test does not access the database."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invalid registration returns 400', () => pm.response.to.have.status(400));",
                  "pm.test('Validation error uses JSON envelope', () => { const body = pm.response.json(); pm.expect(body.success).to.eql(false); pm.expect(body.error.code).to.eql('VALIDATION_ERROR'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Register test user (database required)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"name\": \"Postman Test User\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/auth/register",
            "description": "Run after configuring real Neon URLs and applying the Prisma migration. A fresh random email is generated each time."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('testEmail', pm.variables.replaceIn('{{$randomEmail}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Registration creates an account', () => pm.response.to.have.status(201));",
                  "pm.test('Registration returns a user without a password hash', () => { const body = pm.response.json(); pm.expect(body.data.user.email).to.eql(pm.collectionVariables.get('testEmail')); pm.expect(body.data.user).not.to.have.property('passwordHash'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Login test user (database required)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/auth/login",
            "description": "Run after Register. Postman keeps the HttpOnly token cookie for the following requests."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeds', () => pm.response.to.have.status(200));",
                  "pm.test('Login returns the user', () => pm.expect(pm.response.json().data.user.email).to.eql(pm.collectionVariables.get('testEmail')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Current user (login required)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/me",
            "description": "Run after Register or Login. Postman should send the stored token cookie automatically."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Current user is authenticated', () => pm.response.to.have.status(200));",
                  "pm.test('Current user matches the test account', () => pm.expect(pm.response.json().data.user.email).to.eql(pm.collectionVariables.get('testEmail')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/logout",
            "description": "Clears the HttpOnly token cookie in Postman's cookie jar."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Logout succeeds', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Current user after logout (401 expected)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/me",
            "description": "Run after Logout to confirm the cookie is no longer accepted."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Logged-out user is unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
