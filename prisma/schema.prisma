generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  REFRESH_TOKEN
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  firstName               String?
  lastName                String?
  name                    String?
  passwordHash            String
  isActive                Boolean                  @default(true)
  emailVerifiedAt         DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  authTokens              AuthToken[]

  @@index([createdAt])
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  familyId  String?
  revokedAt DateTime?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, expiresAt])
  @@index([familyId, type, revokedAt])
}

model EmailVerificationChallenge {
  email        String   @id
  otpHash      String
  expiresAt    DateTime
  firstName    String?
  lastName     String?
  passwordHash String?
  createdAt    DateTime @default(now())

  @@index([expiresAt])
}
