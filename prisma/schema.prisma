generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum GenerationMode {
  TEXT_TO_IMAGE
  IMAGE_TO_IMAGE
  TEXT_TO_VIDEO
  IMAGE_TO_VIDEO
  VIDEO_TO_VIDEO
}

enum GenerationStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum AssetType {
  SOURCE
  RESULT
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PAST_DUE
}

enum CreditTransactionType {
  PURCHASE
  GENERATION
  REFUND
  GRANT
}

enum FeedbackCategory {
  BUG
  FEATURE
  IMAGE_QUALITY
  OTHER
}

enum FeedbackStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  REFRESH_TOKEN
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  firstName               String?
  lastName                String?
  name                    String?
  passwordHash            String
  role                    UserRole                 @default(USER)
  credits                 Int                      @default(0)
  isActive                Boolean                  @default(true)
  emailVerifiedAt         DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  generations             GenerationJob[]
  assets                  ImageAsset[]
  videoAssets             VideoAsset[]
  videoUploadReservations VideoUploadReservation[]
  imageUploadUsages       ImageUploadUsage[]
  imageUploadReservations ImageUploadReservation[]
  creditTransactions      CreditTransaction[]
  creditUsages            CreditUsage[]
  payments                Payment[]
  subscriptions           Subscription[]
  feedback                Feedback[]
  authTokens              AuthToken[]
  planGrantsGiven         PlanGrant[]              @relation("PlanGrantGrantedBy")
  planGrantsReceived      PlanGrant[]              @relation("PlanGrantRecipient")

  @@index([createdAt])
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  familyId  String?
  revokedAt DateTime?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, expiresAt])
  @@index([familyId, type, revokedAt])
}

model EmailVerificationChallenge {
  email        String   @id
  otpHash      String
  expiresAt    DateTime
  firstName    String?
  lastName     String?
  passwordHash String?
  createdAt    DateTime @default(now())

  @@index([expiresAt])
}

model GenerationJob {
  id                 String              @id @default(cuid())
  userId             String
  mode               GenerationMode
  status             GenerationStatus    @default(QUEUED)
  prompt             String?
  negativePrompt     String?
  settings           Json?
  sourceVideoId      String?
  provider           String?
  model              String?
  creditsUsed        Int                 @default(0)
  errorCode          String?
  errorMessage       String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  assets             ImageAsset[]
  videoAssets        VideoAsset[]
  sourceVideo        VideoAsset?         @relation("VideoGenerationSource", fields: [sourceVideoId], references: [id], onDelete: SetNull)
  creditTransactions CreditTransaction[]
  feedback           Feedback[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model ImageAsset {
  id              String         @id @default(cuid())
  userId          String
  generationId    String?
  type            AssetType
  url             String
  publicId        String
  format          String?
  width           Int?
  height          Int?
  fileSizeBytes   Int            @default(0)
  deletionPending Boolean        @default(false)
  createdAt       DateTime       @default(now())
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  generation      GenerationJob? @relation(fields: [generationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([generationId])
}

model VideoAsset {
  id                String          @id @default(cuid())
  userId            String
  generationId      String?
  type              VideoAssetType
  url               String
  publicId          String
  format            String?
  fileSizeBytes     Int             @default(0)
  deletionPending   Boolean         @default(false)
  createdAt         DateTime        @default(now())
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  generation        GenerationJob?  @relation(fields: [generationId], references: [id], onDelete: SetNull)
  sourceGenerations GenerationJob[] @relation("VideoGenerationSource")

  @@index([userId, createdAt])
  @@index([generationId])
}

model VideoUploadReservation {
  id            String   @id
  userId        String
  publicId      String
  fileSizeBytes Int
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

enum VideoAssetType {
  SOURCE
  RESULT
}

model ImageUploadUsage {
  id          String   @id @default(cuid())
  userId      String
  periodStart DateTime
  uploads     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodStart])
}

model ImageUploadReservation {
  id            String   @id
  userId        String
  periodStart   DateTime
  fileSizeBytes Int
  publicId      String
  createdAt     DateTime @default(now())
  expiresAt     DateTime
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Plan {
  id                     String         @id @default(cuid())
  slug                   String         @unique
  name                   String
  priceCents             Int?
  currency               String         @default("USD")
  monthlyCredits         Int            @default(0)
  textToImageCredits     Int            @default(0)
  imageToImageCredits    Int            @default(0)
  textToVideoCredits     Int            @default(0)
  imageToVideoCredits    Int            @default(0)
  videoToVideoCredits    Int            @default(0)
  monthlyImageUploads    Int            @default(0)
  libraryImageLimit      Int            @default(0)
  libraryVideoLimit      Int            @default(0)
  imageStorageLimitBytes Int            @default(0)
  isActive               Boolean        @default(true)
  isComingSoon           Boolean        @default(false)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  payments               Payment[]
  subscriptions          Subscription[]
  grants                 PlanGrant[]
}

model Subscription {
  id                 String             @id @default(cuid())
  userId             String
  planId             String
  status             SubscriptionStatus @default(ACTIVE)
  provider           String?
  providerReference  String?            @unique
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan               Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments           Payment[]
  grants             PlanGrant[]

  @@index([userId, status])
}

model PlanGrant {
  id              String        @id @default(cuid())
  recipientUserId String
  grantedByUserId String?
  planId          String
  subscriptionId  String?
  durationDays    Int
  note            String?
  createdAt       DateTime      @default(now())
  recipient       User          @relation("PlanGrantRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  grantedBy       User?         @relation("PlanGrantGrantedBy", fields: [grantedByUserId], references: [id], onDelete: SetNull)
  plan            Plan          @relation(fields: [planId], references: [id], onDelete: Restrict)
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([recipientUserId, createdAt])
  @@index([grantedByUserId, createdAt])
}

model Payment {
  id                String             @id @default(cuid())
  userId            String
  planId            String?
  subscriptionId    String?
  provider          String
  providerPaymentId String?            @unique
  amountCents       Int
  currency          String             @default("USD")
  status            PaymentStatus      @default(PENDING)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan              Plan?              @relation(fields: [planId], references: [id], onDelete: SetNull)
  subscription      Subscription?      @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  creditTransaction CreditTransaction?

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model CreditTransaction {
  id           String                @id @default(cuid())
  userId       String
  paymentId    String?               @unique
  generationId String?
  type         CreditTransactionType
  amount       Int
  periodStart  DateTime?
  mode         GenerationMode?
  description  String
  createdAt    DateTime              @default(now())
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment      Payment?              @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  generation   GenerationJob?        @relation(fields: [generationId], references: [id], onDelete: SetNull)

  @@unique([generationId, type])
  @@index([userId, createdAt])
}

model CreditUsage {
  id          String         @id @default(cuid())
  userId      String
  mode        GenerationMode
  periodStart DateTime
  used        Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mode, periodStart])
  @@index([periodStart])
}

model Feedback {
  id           String           @id @default(cuid())
  userId       String
  generationId String?
  category     FeedbackCategory
  status       FeedbackStatus   @default(OPEN)
  rating       Int?
  message      String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  generation   GenerationJob?   @relation(fields: [generationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}
