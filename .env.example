NODE_ENV=development
PORT=3000

# Neon pooled connection for the application and direct connection for Prisma CLI.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require

# Redis connection used by BullMQ.
REDIS_URL=redis://localhost:6379

# Replace with a long, random value before running the application.
JWT_SECRET=replace-with-a-long-random-secret

# Cloudinary credentials.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gemini image-generation API key.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_VIDEO_MODEL=gemini-omni-1.1-flash
GENERATION_TIMEOUT_MS=300000

# SMTP settings for verification and password-reset emails.
APP_BASE_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=