NODE_ENV=development
PORT=3000

# Neon pooled connection for the application and direct connection for Prisma CLI.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require

# Redis connection used by BullMQ.
REDIS_URL=redis://localhost:6379

# Replace with a long, random value before running the application.
JWT_SECRET=replace-with-a-long-random-secret

# Cloudinary credentials.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Set after choosing an image generation provider.
IMAGE_PROVIDER_API_KEY=